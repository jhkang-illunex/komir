# RAG 챗봇 — user_id/session_id 히스토리 + 스트리밍. rag/ragkit(기존 하이브리드 검색)를 임포트.
# TODO(구현 단계): geo/Dockerfile 패턴 재사용. e5-small 임베딩 가중치는 airgap 전제상
# 빌드 시점에 이미지에 미리 다운로드해 포함(런타임 인터넷 접근 불가).
FROM python:3.12-slim

WORKDIR /app
COPY services/rag_chat/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# TODO: 임베딩 모델 사전 다운로드 RUN 스텝(연결망 빌드 시점 1회)
# RUN python -c "from sentence_transformers import SentenceTransformer; \
#     SentenceTransformer('intfloat/multilingual-e5-small')"

COPY services/rag_chat/app ./app
COPY services/shared ./shared
# 주의(2026-08-05): rag/ 전체를 COPY하지 말 것 — rag/index/rag.duckdb(벡터+BM25 인덱스,
# Qdrant/Postgres 이관 후 더 이상 정본 아님)와 rag/docs/estimate_question(원본 문서·
# 골든셋)이 함께 딸려와 §0 요구사항②("DB는 외부서비스")와 충돌한다. ragkit 코드 모듈만
# 선택 COPY(예: COPY rag/ragkit ./rag/ragkit) — 정확한 서브셋은 구현 단계에서 확정.
COPY rag/ragkit ./rag/ragkit

ENV PYTHONUNBUFFERED=1
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
EXPOSE 8002
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8002"]
