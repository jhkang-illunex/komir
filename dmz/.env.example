# komir DMZ 존 환경변수 계약 (2026-08-06)
# 복사: cp .env.example .env (커밋 금지 — .gitignore의 .env/**/.env 규칙 적용)
#
# DMZ 존 원칙: LLM 사용 불가, DB 직접 접근 없음 — 여기 있는 건 전부 "외부 원천에서
# 데이터를 받아오는 데" 필요한 키뿐이다. LLM_* 계열 변수는 이 파일에 절대 넣지 않는다
# (documents/meta/CONTAINER_ARCHITECTURE.md §0-1 참고).

# ── 정형 수집 키 (dmz/msr_collectors/*) ──
# 공공데이터포털 - 관세청 품목별 국가별 수출입실적(GW)
DATA_GO_KR_SERVICE_KEY_ENCODING=
DATA_GO_KR_SERVICE_KEY_DECODING=
# 한국은행 ECOS
ECOS_API_KEY=
# 인도네시아 통계청 BPS(webapi.bps.go.id)
BPS_API_KEY=
# 미국 Census Bureau 무역통계 API(api.census.gov)
CENSUS_API_KEY=
# UN Comtrade 정식 키(comtradedeveloper.un.org) — primary/secondary
COMTRADE_API_KEY=
COMTRADE_API_KEY_2=

# ── 수집 산출물 임시 저장 경로 (dmz/msr_collectors/config.py의 COLLECT_OUT) ──
# in-house 쪽 msr/config.py의 MSR_COLLECT_OUT과 같은 값으로 맞출 것 — 망연계 전달 후
# in-house가 이 경로(공유 마운트/rsync 사본)를 그대로 읽는다.
MSR_COLLECT_OUT=./msr_collect_out

# ── DMZ 수집 스케줄(2026-08-06 확정, 소스별 차등 — 목표아키텍처_DMZ_inhouse_흐름_
#    260806.md §2-3 상세). 하드코딩 금지, 값 변경 후 서비스 재시작으로 반영 ──
GKG_COLLECT_CRON="0 * * * *"               # GDELT/GKG, 매시 정각(Tier 0)
TIER1_MARKET_COLLECT_CRON="0 */4 * * *"    # 거래소재고·COT, 4시간마다(Tier 1)
TIER2_STATS_COLLECT_CRON="0 2 * * *"       # 관세청·ECOS·Comtrade 등 정형 통계, 일 1회(Tier 2)
TIER3_POLICY_COLLECT_CRON="0 3 * * SAT"    # MOFCOM 등 정책공고류, 주 1회 유지(Tier 3)
TIER4_UNSTABLE_COLLECT_CRON="0 4 * * SAT"  # GACC 등 반차단 소스, 주 1회 이하(Tier 4)
DMZ_TO_INHOUSE_TRANSFER_CRON="0 1 * * *"   # airgap 전달, 매일 새벽 1시(전 Tier 공통)
