# mnrl_report — 통합보고서 주간 규칙 엔진(supercronic cron 컨테이너, ingest와 동일 패턴)
# build: cd inhouse && docker build -f mnrl_report/Containerfile -t komir-mnrl-report:<tag> .
# run  : docker run -d --name komir-mnrl-report --env-file .env \
#          -e LLM_BASE_URL=http://host.docker.internal:52302/v1 --add-host=host.docker.internal:host-gateway \
#          komir-mnrl-report:<tag>
FROM python:3.12-slim
WORKDIR /komir/inhouse

COPY mnrl_report/requirements.txt ./mnrl_report/requirements.txt
RUN pip install --no-cache-dir -r mnrl_report/requirements.txt

ADD https://github.com/aptible/supercronic/releases/download/v0.2.34/supercronic-linux-amd64 \
    /usr/local/bin/supercronic
RUN echo "a51b340a83c5bd035742f0d7191555f9663876405e494dbf824537d64f3e39c6  /usr/local/bin/supercronic" \
    | sha256sum -c && chmod +x /usr/local/bin/supercronic

COPY common ./common
COPY mnrl_report ./mnrl_report
RUN chmod +x mnrl_report/entrypoint.sh mnrl_report/cron_mnrl_report_weekly.sh
ENV PYTHONUNBUFFERED=1
CMD ["/komir/inhouse/mnrl_report/entrypoint.sh"]
