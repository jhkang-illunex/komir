# Report 생성 — 템플릿×(비정형+정형) 조립, 주기 저장(out_report).
#
# 2026-08-11 1차 구현: 정형(RDB) 섹션만 배선했다. app/generator.py가 komir 산출물
# (out_diagnosis_alert·out_import_forecast·geo_index @ MSR_DB)과 KOMIS 공개 원천
# (public.KO_* @ PG_DSN, 읽기 전용)을 읽어 app/templates/weekly_brief.md.j2로 조립한다.
# 비정형(VectorDB/PageIndex) 섹션과 rag_chat retrieval/ 공유는 아직 미해결 —
# §6 "중복 구현 금지"대로 services/shared/retrieval/로 올리는 게 후속 과제다
# (지금은 rag_chat 코드를 import하지도, 복제하지도 않았다).
FROM python:3.12-slim

WORKDIR /app
COPY report_gen/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY report_gen/app ./app
COPY common ./common
# 2026-09-07 expired/ 이동: geo/llm→common/llm, geo/extractors.py→ingest/extractors.py,
# mineral_supply_risk/db/dbio.py→common/dbio.py로 흡수돼 geo/·mineral_supply_risk/ COPY 불필요.

# ingest/(2026-08-11 services/ingestion으로 신설 → 2026-08-27 inhouse/ingest/로
# 독립 패키지화, 병합계획_komis-report-generator_260811.md) — RAG·Report 겸용 공통
# 모듈(§5-3). COPY ingest ./ingest
# analysis/prompt_store.py가 ai_cfg.cfg_prompt 컬럼 자동 추가에 쓰는 DDL(2026-08-27
# 신설). 컬럼 자동 추가 경로가 실제로 타지 않는 한(운영 DB에 이미 최신 컬럼이
# 있으면) 안 쓰이지만, prompt_store 모듈 import 시점에 경로를 계산하므로 파일
# 자체는 항상 있어야 한다(없으면 아래 prompt_store.py의 탐색이 예외를 던짐).
COPY data_lake/db/schema_ai_cfg.sql ./data_lake/db/schema_ai_cfg.sql

ENV PYTHONUNBUFFERED=1
EXPOSE 8003
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8003"]
