# Report 생성 — 템플릿×(비정형+정형) 조립, 주기 저장(out_report).
# TODO(구현 단계): rag_chat과 검색 계층(retrieval/)을 공유할지, 이 서비스 안에 복제할지
# 결정 필요(§6 — 중복 구현 금지 원칙상 공유 라이브러리화 권장, 예: services/shared/retrieval/).
FROM python:3.12-slim

WORKDIR /app
COPY services/report_gen/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY services/report_gen/app ./app
COPY services/shared ./shared

ENV PYTHONUNBUFFERED=1
EXPOSE 8003
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8003"]
