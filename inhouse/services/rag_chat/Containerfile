# RAG 챗봇 — user_id/session_id 히스토리 + 스트리밍. 정형(Postgres out_*)·
# dense(pgvector doc_chunk)·PageIndex(OKF 트리) 3도구를 LangGraph로 조합한다
# (rag/ragkit/chatbot_graph.py, 2026-08-13). dense용 임베딩 모델(e5-small)만
# 이 컨테이너 안에서 직접 로드하고, PageIndex는 트리 JSON을 파일로 읽는다 —
# PAGEINDEX_TREES_DIR·OKF_DOCUMENTS_DIR가 가리키는 data_lake/semi_structure/
# {pageindex_trees,okf_documents}는 이미지에 안 굽고 볼륨 마운트로 붙일 것
# (§0 "DB는 외부서비스" 원칙과 같은 이유 — 대용량 산출물을 이미지에 넣지 않는다).
# e5-small 임베딩 가중치는 airgap 전제상 빌드 시점(망 연결 가능)에 이미지에 미리
# 다운로드해 포함한다 — 런타임엔 인터넷 접근이 없다는 전제라 HF_HUB_OFFLINE=1로
# 캐시 재다운로드를 막는다(2026-08-19 실제 구현·빌드 검증, 모델명은
# rag/ragkit/embed.py의 MODEL_NAME과 반드시 일치시킬 것).
FROM python:3.12-slim

WORKDIR /app
COPY services/rag_chat/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN python -c "from sentence_transformers import SentenceTransformer; \
    SentenceTransformer('intfloat/multilingual-e5-small')"

# app/ 아래에 페이지추천 이식본(app/page_recommend/)과 그 리소스(43개 페이지 YAML +
# KOMIS 메타데이터 스냅샷, 합계 400KB)가 함께 들어 있다 — 이 COPY 한 줄로 같이 실린다
# (2026-08-11: 리소스를 패키지 안에 둔 이유는 registry.py/metadata.py가 패키지 상대경로로
# 찾기 때문. 별도 COPY 라인 불필요).
COPY services/rag_chat/app ./app
COPY services/shared ./shared
# 주의(2026-08-05): rag/ 전체를 COPY하지 말 것 — rag/index/rag.duckdb(벡터+
# BM25 인덱스, Qdrant/Postgres 이관 후 더 이상 정본 아님)와 rag/docs/estimate_question
# (원본 문서·골든셋)이 함께 딸려와 §0 요구사항②("DB는 외부서비스")와 충돌한다. ragkit 코드
# 모듈만 선택 COPY — 정확한 서브셋은 구현 단계에서 확정.
# (2026-08-11: 경로를 engine/rag/ragkit → rag/ragkit으로 정정 — 2026-08-06 DMZ/inhouse
# 분리로 engine/이 없어지고 inhouse/rag가 됐음, 이 Containerfile 빌드 컨텍스트는 inhouse/)
COPY rag/ragkit ./rag/ragkit

# rag/ragkit/generate.py·chatbot.py·services/shared/llm_client.py가 공통으로 쓰는
# geo/llm/openai_compat.OpenAICompatChat — geo/ 전체가 아니라 llm/ 서브패키지만
# (geo/__init__.py·geo/extractors.py 최소 COPY와 같은 이유, 수집기·추출기는 불필요).
# 2026-08-13 실측: 이전엔 이 COPY가 빠져 있어 컨테이너가 뜨면 import 단계에서
# 바로 깨졌을 지점(소스트리 실행에서는 상위 sys.path 삽입으로 가려져 안 드러났음).
COPY geo/llm ./geo/llm

# ingest/(2026-08-11 services/ingestion으로 신설 → 2026-08-27 inhouse/ingest/로
# 독립 패키지화, 병합계획_komis-report-generator_260811.md) — PDF 파서가
# geo.extractors(opendataloader+OCR 폴백 체인)를 그대로 재사용하므로 geo 패키지 중
# 그 파일만 최소 COPY(geo/ 전체엔 collectors 등 이 서비스에 불필요한 코드가 많음 —
# extractors.py가 유일한 in-package 의존성). 패키지명이 ingest로 바뀌었으니
# 컨테이너 안 경로도 ./ingest(소스트리와 동일 상대경로).
COPY ingest ./ingest
COPY geo/__init__.py ./geo/__init__.py
COPY geo/extractors.py ./geo/extractors.py

# services/shared/db.py가 mineral_supply_risk/db/dbio.py를 재노출(2026-08-11) —
# 엔진 전체가 아니라 db/ 서브패키지만 COPY(수집기·모델 코드는 이 서비스에 불필요).
COPY mineral_supply_risk/db ./mineral_supply_risk/db

ENV PYTHONUNBUFFERED=1
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
EXPOSE 8002
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8002"]
