# komir in-house(airgap) 존 통합 환경변수 계약 (2026-08-06)
# 복사: cp .env.example .env (커밋 금지 — .gitignore .env/**/.env 규칙 적용)
#
# 기존 geo/.env.example·mineral_supply_risk/.env.example·inhouse/deploy/.env.example
# 컨벤션을 하나로 합친 것 — 새 접두사 없음(documents/meta/CONTAINER_ARCHITECTURE.md §3).
# DMZ 전용 수집 키(관세청·ECOS·BPS·Census·Comtrade)는 여기 없음 — dmz/.env 참고.

# ── 정형 DB(현재 DuckDB, 향후 data_lake.rdb로 이관 예정 — §0-1) ──
MSR_DB=./data_lake/db/minerals.duckdb
# 서버DB(data_lake.rdb)로 이관 시 SQLAlchemy URL로 교체:
#   MSR_DB=oracle+cx_oracle://user:pw@host:1521/?service_name=data_lake.rdb
MSR_PUBLISH_SCHEMA=
MSR_COLLECT_OUT=./msr_collect_out   # dmz/.env의 MSR_COLLECT_OUT과 같은 값(공유 마운트/rsync 사본)

# ── PostgreSQL(data_lake.rdb 이관 대상, 2026-08-10 신설) ──
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_DSN=postgresql+psycopg2://user:pw@host:5432/dbname

# ── LLM/임베딩(외부 서비스, 필수) ──
LLM_PROVIDER=openai_compat          # rule | mock | openai_compat | anthropic
LLM_BASE_URL=http://host.docker.internal:52302/v1
LLM_MODEL=gemma-4-26b-a4b
LLM_API_KEY=                        # 로컬 vLLM은 인증 불필요 → 빈 값(인라인 주석 금지)
LLM_TEMPERATURE=0
LLM_CONCURRENCY=8
PDF_MAXPAGES=40
EMBEDDING_BASE_URL=                 # 비워두면 로컬 e5-small 컨테이너 내 실행
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# airgap 필수(§7) — 로컬 캐시 있어도 기본적으로 버전확인·텔레메트리 목적 네트워크 호출 시도함
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ── 벡터DB — data-lake 논리상 벡터 파트지만 물리적으로 komir이 직접 소유·기동(§0-1) ──
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=doc_chunks
QDRANT__TELEMETRY_DISABLED=true     # airgap 필수 — 텔레메트리 기본 활성 함정

# ── 챗봇 서비스 ──
CHAT_SESSION_TTL_DAYS=90
CHAT_STREAM_CHUNK_MS=50
# 페이지추천(rag_chat/app/page_recommend)이 "최근 5년" 같은 상대기간을 해석할 기준 지역
KOMIS_TIMEZONE=Asia/Seoul

# ── 리포트 스케줄러 ──
REPORT_SCHEDULE_CRON="0 6 * * MON"
REPORT_TEMPLATE_DIR=/app/templates

# ── AI 서버군 갱신 스케줄(2026-08-06 확정, §0-1) — 하드코딩 금지, 재시작으로 반영.
#    "매월 첫째주 일요일"은 순수 cron 문자열로 부족할 수 있음(day-of-month·day-of-week
#    AND 결합 필요 — APScheduler CronTrigger(day='1-7', day_of_week='sun') 패턴 참고) ──
INGESTION_SCHEDULE_CRON="0 0 * * SUN"      # 정형+비정형+RAG 인덱스 전체, 매주 일요일
DIAGNOSIS_TRIGGER=after_geo_index          # cron 아님 — 지정학위기지수 갱신 직후 이벤트 체이닝
FORECAST_SCHEDULE_CRON="0 1 1-7 * SUN"     # 매월 첫째주 일요일만
