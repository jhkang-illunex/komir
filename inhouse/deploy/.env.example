# komir services/ 통합 환경변수 계약 — 설계 단계 초안
# (docs/CONTAINER_ARCHITECTURE.md §3). 기존 geo/.env.example·mineral_supply_risk/
# .env.example 컨벤션을 그대로 확장한 것 — 새 접두사 없음.

# ── DB(외부 서비스, 필수) — 기존 DuckDB 경로를 대체 ──
MSR_DB=postgresql+psycopg2://user:pw@host:5432/minerals
MSR_PUBLISH_SCHEMA=

# ── LLM/임베딩(외부 서비스, 필수 — 기존 geo 컨벤션 그대로) ──
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0

# rag-chat·report-gen 전용 LLM 엔드포인트 오버라이드(선택, 기본은 비워둠).
# 지금은 위 LLM_BASE_URL 하나를 두 서비스가 함께 쓴다(단일 모델 인스턴스 공유 전제,
# 2026-08-13 논의) — 발주처 실배포 디바이스가 확정되어 두 서비스를 서로 다른 LLM
# 인스턴스로 물리 분리하기로 결정되면, 아래 값만 채우면 된다(compose 파일·코드 변경
# 불필요 — docker-compose.yml·podman-compose.yml이 이미 "비어있으면 LLM_BASE_URL로
# 폴백"하도록 배선돼 있음).
RAG_CHAT_LLM_BASE_URL=
REPORT_GEN_LLM_BASE_URL=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# airgap 필수(§7) — sentence-transformers/huggingface_hub가 로컬 캐시가 있어도 기본적으로
# 버전확인·텔레메트리 목적 네트워크 호출을 시도함. 반드시 둘 다 켤 것.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ── 벡터DB(komir이 직접 소유·기동 — LLM/정형DB와 달리 외부 서비스 아님, §0·§4) ──
QDRANT_URL=http://qdrant:6333        # podman-compose.yml 내부 서비스명 기본값
QDRANT_COLLECTION=doc_chunks

# ── 챗봇 서비스 ──
CHAT_SESSION_TTL_DAYS=90
CHAT_STREAM_CHUNK_MS=50

# ── 리포트 스케줄러 ──
REPORT_SCHEDULE_CRON=0 6 * * MON
REPORT_TEMPLATE_DIR=/app/templates
